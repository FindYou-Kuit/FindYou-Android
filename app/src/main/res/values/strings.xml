    <!--adopt info-->
    <string name="adopt_info_sub_title">유기 동물 입양 절차 및 주의점</string>
    <string name="adopt_info_description">유기 동물을 입양해야 하는 이유와 입양 절차 등, 유기 동물 입양과 관련된 여러 정보들을 알아봅시다!</string>

    <string name="adopt_info_reason_title">입양을 해야 하는 이유</string>
    <string name="adopt_info_reason_first">1. 유기되거나 버려져 상처를 입은 동물들에게 새로운 집과 행복을 줄 수 있어요!</string>
    <string name="adopt_info_reason_second">2. 동물 보호와 복지에 참여할 수 있어요!</string>
    <string name="adopt_info_reason_third">3. 유기 동물 문제를 해결하는데 기여할 수 있어요!</string>

    <string name="adopt_info_alert_title">※ 사지 말고 입양하세요!</string>
    <string name="adopt_info_alert_description">펫샵에서 사지 않고 입양을 선택하는 건 동물의 생명을 구하고 사회적 가치를 실현하는 소중한 행동이에요.\n입양을 통해 동물과 사랑이 함께 행복한 사회를 만들어요!</string>

    <string name="adopt_info_sequence_title">유기 동물 입양 절차</string>

    <string name="adopt_info_sequence_first_title">1. 유기 동물 확인</string>
    <string name="adopt_info_sequence_first_description">아래와 같은 경로로 입양하고 싶은 아이를 찾아보아요!</string>
    <string name="adopt_info_sequence_first_tag">(1) 앱 내에 "보호 중"태그가 달린 아이들</string>
    <string name="adopt_info_sequence_first_site">(2) 유기 동물 온라인 조회 사이트</string>
    <string name="adopt_info_sequence_first_center">(3) 유기 동물보호소</string>

    <string name="adopt_info_sequence_second_title">2. 상담 예약 및 입양 신청서 작성</string>
    <string name="adopt_info_sequence_second_description">입양하려는 아이가 있는 보호소에 연락해 방문 및 상담 예약을 진행하고, 필요한 입양 신청서를 작성해요.</string>
    <string name="adopt_info_sequence_second_alert_title">입양 신청서에는 다음과 같은 정보를 기재해야 해요!</string>
    <string name="adopt_info_sequence_second_alert_description_1">(1) 가족 구성원, 혼인 정보 등을 포함한 입양자의 개인정보</string>
    <string name="adopt_info_sequence_second_alert_description_2">(2) 입양 후 계획, 예상 비용 등 입양자의 입양 의지</string>

    <string name="adopt_info_sequence_third_title">3. 방문 및 상담 진행</string>
    <string name="adopt_info_sequence_third_description">해당 보호소나 보호센터에 방문해서 상담을 진행해요. 입양하려는 이유, 의지 등에 대해 얘기해요.</string>

    <string name="adopt_info_sequence_fourth_title">4. 교육 이수 및 입양료 납부</string>
    <string name="adopt_info_sequence_fourth_description">보호소, 보호센터별로 입양 절차가 다룰 수 있어요. 입양을 위한 교육을 시청해야 하거나, 소정의 입양료를 납부해야 할 수 있어요.</string>
    <string name="adopt_info_sequence_fourth_alert_title">입양비를 지원받을 수 있어요!</string>
    <string name="adopt_info_sequence_fourth_alert_description">여러 지자체나 센터에서 유기 동물 입양비 지원 사업을 시행하고 있어서 입양비를 지원받을 수도 있어요!</string>

    <string name="adopt_info_sequence_fifth_title">5. 유기 동물 입양</string>
    <string name="adopt_info_sequence_fifth_description">입양한 동물의 소유권을 증명할 수 있는 중요한 문서에요!</string>
    <string name="adopt_info_sequence_fifth_sub_description_1">(1) 모든 절차가 완료되면 입양 확인서를 발급받을 수 있어요.</string>
    <string name="adopt_info_sequence_fifth_sub_description_2">(2) 입양한 날짜를 조율하고 아이를 맞이할 준비를 합니다.</string>

    <string name="adopt_info_sequence_sixth_title">유기 동물 입양 시 주의점</string>
    <string name="adopt_info_sequence_sixth_patience_title">인내심</string>
    <string name="adopt_info_sequence_sixth_patience_description">입양한 동물이 낯선 환경에 무서워할 수 있어요. 아이가 적응할 때까지 인내심을 가지고 기다려줘야 해요!</string>
    <string name="adopt_info_sequence_sixth_responsibility_title">책임감</string>
    <string name="adopt_info_sequence_sixth_responsibility_description">충분한 운동과 놀이 시간, 적절한 자료 등을 통해 아이를 행복하게 해줘야 해요.\n유기 동물에게는 파양 당한 경험이 큰 상처로 남아요.\n입양한 동물이 늙고 병들어도 책임감 있게 평생 함께 하겠다는 마음가짐이 필요해요.</string>

    <!--volunteer info-->
    <string name="volunteer_info_sub_title">유기동물 봉사 방법 및 주의사항</string>
    <string name="volunteer_info_description">유기동물 봉사를 신청하는 법, 봉사 시 주의사항과 실제로 어떤 봉사를 하는지에 대해서 알아봅시다!</string>

    <string name="volunteer_info_application_title">유기동물 봉사 신청법</string>
    <string name="volunteer_info_application_description_1">1. 1365 자원봉사 포털에 들어가 유기견 봉사를 검색해 신청할 수 있어요.</string>
    <string name="volunteer_info_application_description_2">2. 각 보호소에서 운영하고 있는 인스타, 네이버 카페, 전화나 문자 등 다양한 방법으로 직접 신청할 수 있어요.</string>
    <string name="volunteer_info_application_description_3">3. 대학생 봉사 동아리나 직장인 봉사 모임 등에 가입해서 여럿이서, 정기적으로 봉사를 할 수도 있어요.</string>
    <string name="volunteer_info_application_portal">자원봉사 포털 바로가기</string>

    <string name="volunteer_info_alert_title">봉사 신청이나 예약 시 금액이 발생할 수 있어요!</string>
    <string name="volunteer_info_alert_description">봉사 물품 지원, 카풀 비용 등에 사용되고,\n남은 비용은 보호소 운영에 사용됩니다:)</string>

    <string name="volunteer_info_required_item_title">유기동물 봉사 준비물</string>
    <string name="volunteer_info_alert_required_item_description">먼지와 털이 많이 날리기 때문에 복장에 주의해야 해요!</string>
    <string name="volunteer_info_alert_required_item_detail_description_1">(1) 방진복(혹은 오염되어도 무방한 옷)</string>
    <string name="volunteer_info_alert_required_item_detail_description_2">(2) 장갑과 장화(혹은 오염되어도 무방한 옷)</string>
    <string name="volunteer_info_alert_required_item_detail_description_3">(3) 마스크</string>
    <string name="volunteer_info_alert_required_item_alert">※ 겨울엔 방한용품과 핫팩을,\n※ 여름엔 자외선을 차단할 썬크림과 챙모자를 준비해주세요!</string>

    <string name="volunteer_info_title">유기동물 보호소 봉사 방법</string>

    <string name="volunteer_info_first_title">1. 견사, 묘사 청소하기</string>
    <string name="volunteer_info_first_description">털과 먼지, 동물의 배설물들을 치우고 깔끔히 청소해요.</string>
    <string name="volunteer_info_first_alert_title">※ 출입 시 주의사항!</string>
    <string name="volunteer_info_first_alert_description">활발하거나 날쌘 아이는 케이지를 탈출할 수 있어요!\n탈출할 수 없게 잠금장치를 꼭 잠그고 다녀야 합니다!</string>

    <string name="volunteer_info_second_title">2. 사료와 물 급여하기</string>
    <string name="volunteer_info_second_description_1">(1) 비워져있는 사료 그릇과 물 그릇을 채워줘요.</string>
    <string name="volunteer_info_second_description_2">(2) 더러운 그릇은 수거해 설거지하고 새로운 그릇으로 바꿔줘요.</string>

    <string name="volunteer_info_third_title">3. 놀아주기</string>
    <string name="volunteer_info_third_description">좁은 케이지에 갇혀 있어 심심한 아이들과 즐겁게 놀아줘요.</string>
    <string name="volunteer_info_third_description_1">(1) 애교 부리는 아이들을 쓰다듬어 주고 실컷 만져주세요!</string>
    <string name="volunteer_info_third_description_2">(2) 강아지는 관리자분의 지도 하에 직접 산책봉사를 할 수도 있어요!</string>
    <string name="volunteer_info_third_alert_title">※ 봉사자분이 다칠 수도 있으니 안전에 주의해 주세요!</string>

    <string name="volunteer_info_fourth_title">4. 그 외</string>
    <string name="volunteer_info_fourth_sub_title_1">(1) 동물 미용 봉사하기</string>
    <string name="volunteer_info_fourth_sub_description_1">깔끔하게 털을 다듬고, 목욕하고, 빗질해줘요.</string>
    <string name="volunteer_info_fourth_sub_title_2">(2) 보호소 시설 봉사하기</string>
    <string name="volunteer_info_fourth_sub_description_2">시설 보수, 공사, 청소, 이사 등 보호소 유지를 위해 도와줘요.</string>
    <string name="volunteer_info_fourth_sub_2_alert_title">보호소에는 관리자가 부족한 경우가 많아요.</string>
    <string name="volunteer_info_fourth_sub_2_alert_description">그래서 동물 봉사 뿐만 아니라 보호소 유지를 위한 여러가지 다양한 작업들이 필요한 경우도 있습니다.</string>
    <string name="volunteer_info_fourth_sub_title_3">(3) 사진 촬영하기</string>
    <string name="volunteer_info_fourth_sub_description_3">입양 공고를 위한 사진 촬영을 도와줘요.</string>

    <string name="volunteer_info_caution_title">봉사 시 주의사항</string>
    <string name="volunteer_info_caution_description_1">1. 안전이 제일 중요합니다. 다치지 않게 조심히!</string>
    <string name="volunteer_info_caution_description_2">2. 사람을 무서워하거나 새끼가 있는 동물에게는 조심히 다가가야 해요.</string>
    <string name="volunteer_info_caution_description_3">3. 보호소 주소를 유출하면 안 돼요.</string>
    <string name="volunteer_info_caution_sub_description_3">보호소는 괜찮겠지~하고 동물을 유기하고 가는 사람이 있어요..</string>
    <string name="volunteer_info_caution_description_4">4. 먼지나 털이 많이 날리고 오물이 묻을 수 있으니 방진복과 마스크를 꼭 착용해주세요.</string>
    <string name="volunteer_info_caution_description_5">5. 허리를 많이 숙이는 단순 노동 작업들이 많아 몸이 꽤 힘이 들 수 있어서 각오를 하고 오셔야 해요.</string>
</resources>