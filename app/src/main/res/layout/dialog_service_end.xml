<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:background="@android:color/transparent"
        android:clipChildren="false"
        android:clipToPadding="false">

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="288dp"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:layout_marginHorizontal="20dp"
            android:clipChildren="false"
            android:elevation="8dp"
            android:outlineProvider="background"
            android:background="@drawable/bg_report_dialog_rd15">

        <ImageView
                android:id="@+id/iv_service_end_img"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:src="@drawable/img_findu_logo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="50dp" />

        <TextView
                android:id="@+id/tv_service_end_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="서비스 종료 안내"
                android:textAppearance="@style/TextAppearance.FindU.Head1_SB_24"
                android:textColor="@color/gray6"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iv_service_end_img" />

        <TextView
                android:id="@+id/tv_service_end_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/gray5"
                android:textAppearance="@style/TextAppearance.FindU.Body1_R_16"
                app:layout_constraintTop_toBottomOf="@id/tv_service_end_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:text="앱 서비스가 종료되었습니다.\n그동안 찾아주셔서 감사합니다." />

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_service_end_confirm"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="30dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="20dp"
                android:textColor="@color/white"
                android:background="@drawable/bg_button_report_dialog"
                android:backgroundTint="@color/main_color"
                android:text="확인"
                android:textAppearance="@style/TextAppearance.FindU.Head3_SB_18"
                app:layout_constraintTop_toBottomOf="@id/tv_service_end_message"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
