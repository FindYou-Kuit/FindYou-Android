<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_nickname_tooltip"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingEnd="14dp"
    tools:ignore="RtlSymmetry">

    <ImageView
        android:id="@+id/iv_tooltip_tail"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_marginEnd="28dp"
        android:src="@drawable/img_my_message_tail"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="-2dp"
        android:background="@drawable/bg_message_round_gray"
        android:elevation="3dp"
        android:orientation="vertical"
        android:padding="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_tooltip_tail">

        <TextView
            android:id="@+id/tv_tooltip_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="다음과 같은 경우에 불가능해요."
            android:textAppearance="@style/TextAppearance.FindU.caption_12"
            android:textColor="@color/gray5" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1. 중복된 닉네임인 경우"
            android:textAppearance="@style/TextAppearance.FindU.caption_12"
            android:textColor="@color/gray5" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2. 띄어쓰기만 있는 닉네임인 경우"
            android:textAppearance="@style/TextAppearance.FindU.caption_12"
            android:textColor="@color/gray5" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3. 특수문자(!@#$, ^)가 포함되어 있는 경우"
            android:textAppearance="@style/TextAppearance.FindU.caption_12"
            android:textColor="@color/gray5" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>