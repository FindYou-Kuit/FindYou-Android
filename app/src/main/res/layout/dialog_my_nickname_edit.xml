<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_my_dialog"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tv_dialog_nickname"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:paddingBottom="16dp"
        android:text="닉네임 변경"
        android:textAppearance="@style/TextAppearance.FindU.Head2_SB_20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_dialog_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_dialog_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/gray3" />

    <LinearLayout
        android:id="@+id/ll_dialog_my_nickname_edit"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="36dp"
        android:background="@drawable/bg_dialog_my_nickname_edit"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/tv_dialog_nickname">

        <EditText
            android:id="@+id/et_nickname"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="닉네임 입력"
            android:maxLength="8"
            android:minHeight="48dp"
            android:paddingHorizontal="16dp"
            android:textAppearance="@style/TextAppearance.FindU.Body2_SB_14" />

        <TextView
            android:id="@+id/tv_check_duplicate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:paddingStart="8dp"
            android:text="중복확인"
            android:textAppearance="@style/TextAppearance.FindU.Body2_R_14"
            android:textColor="@color/main_color" />

    </LinearLayout>

    <ImageView
        android:id="@+id/iv_nickname_warning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="invisible"
        android:layout_marginEnd="10dp"
        android:src="@drawable/img_my_nickname_warning"
        app:layout_constraintBottom_toBottomOf="@id/ll_dialog_my_nickname_edit"
        app:layout_constraintEnd_toEndOf="@id/ll_dialog_my_nickname_edit"
        app:layout_constraintTop_toTopOf="@id/ll_dialog_my_nickname_edit" />

    <TextView
        android:id="@+id/tv_nickname_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:paddingTop="4dp"
        android:text="(최대 8글자)"
        android:textAppearance="@style/TextAppearance.FindU.caption_12"
        android:textColor="@color/gray4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_dialog_my_nickname_edit" />

    <Button
        android:id="@+id/btn_change_nickname"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="55dp"
        android:background="@drawable/bg_edittext"
        android:backgroundTint="@color/gray1"
        android:enabled="false"
        android:text="변경하기"
        android:textAppearance="@style/TextAppearance.FindU.Head3_SB_18"
        android:textColor="@color/gray4"
        app:layout_constraintTop_toBottomOf="@id/ll_dialog_my_nickname_edit" />
</androidx.constraintlayout.widget.ConstraintLayout>