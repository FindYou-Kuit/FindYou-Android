<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_report_dialog_rd12">

    <LinearLayout
        android:id="@+id/ll_my_delete_history_dialog_mention"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="정말로 삭제하시겠어요?"
            android:textAppearance="@style/TextAppearance.FindU.Head1_SB_24"
            android:textColor="@color/gray6" />


        <TextView
            android:id="@+id/tv_my_delete_history_dialog_mention"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="삭제하면 복구가 어려울 수 있어요.\n다시 한 번 확인해 주세요."
            android:textAppearance="@style/TextAppearance.FindU.Body2_SB_14"
            android:textColor="@color/gray4"
            app:layout_constraintStart_toStartOf="@id/ll_report_image_dialog_mention"
            app:layout_constraintTop_toBottomOf="@id/ll_report_image_dialog_mention" />
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_my_delete_history_dialog_close"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_report_dialog_close_10"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <LinearLayout
        android:layout_width="248dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="15dp"
        android:orientation="vertical"
        android:paddingBottom="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_my_delete_history_dialog_mention">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_my_delete_history_dialog_delete"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:background="@drawable/bg_button_report_dialog"
            android:backgroundTint="@null"
            android:text="삭제하기"
            android:textAppearance="@style/TextAppearance.FindU.Head3_SB_18" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_my_delete_history_dialog_cancel"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button_my_dialog_gray"
            android:backgroundTint="@null"
            android:text="취소"
            android:textAppearance="@style/TextAppearance.FindU.Head3_SB_18"
            android:textColor="@color/gray5" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>