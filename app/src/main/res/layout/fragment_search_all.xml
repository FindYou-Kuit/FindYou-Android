<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_search_all_all"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.ui.search.tablayout.SearchAllFragment">

    <HorizontalScrollView
        android:id="@+id/hs_search_all_filters"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@color/white"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:scrollbars="none"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent">

            <ImageButton
                android:id="@+id/ib_search_all_filter"
                android:layout_width="39dp"
                android:layout_height="34dp"
                android:background="@null"
                android:src="@drawable/ic_search_filters"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cg_search_all_group_filters"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="5dp"
                app:chipSpacingHorizontal="5dp"
                app:layout_constraintStart_toEndOf="@id/ib_search_all_filter"
                app:layout_constraintTop_toTopOf="parent"
                app:singleLine="true">

            </com.google.android.material.chip.ChipGroup>


        </androidx.constraintlayout.widget.ConstraintLayout>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_search_all_horizontal_content"
        android:layout_width="320dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="20dp"
        android:clipToPadding="false"
        android:paddingTop="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hs_search_all_filters" />


    <ImageButton
        android:id="@+id/ib_search_all_horizontal_sort"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="20dp"
        android:background="@null"
        android:elevation="2dp"
        android:minHeight="0dp"
        android:src="@drawable/ic_search_horizontal_sort"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hs_search_all_filters" />


</androidx.constraintlayout.widget.ConstraintLayout>