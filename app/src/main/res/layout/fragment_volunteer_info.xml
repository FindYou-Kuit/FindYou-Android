<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.ui.info.VolunteerInfoFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_volunteer_info_top_bar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="360:56"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/info_top_bar"
            android:textAppearance="@style/TextAppearance.FindU.Head3_SB_18"
            android:textColor="@color/gray6"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_volunteer_info_sub_bar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="360:52"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cl_volunteer_info_top_bar">

        <ImageView
            android:id="@+id/iv_volunteer_info_back"
            android:layout_width="7dp"
            android:layout_height="15dp"
            android:layout_marginStart="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_search_content_back_button"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="@string/volunteer_info_sub_title"
            android:textAppearance="@style/TextAppearance.FindU.Head3_R_18"
            android:textColor="@color/gray6"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/iv_volunteer_info_back"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cl_volunteer_info_sub_bar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/iv_volunteer_info"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginBottom="-10dp"
                android:contentDescription="@null"
                android:elevation="1dp"
                android:scaleType="centerCrop"
                android:src="@drawable/img_volunteer_info"
                app:layout_constraintDimensionRatio="360:208"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/iv_info_image_bottom"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:contentDescription="@null"
                android:elevation="2dp"
                android:scaleType="fitXY"
                android:src="@drawable/bg_top_radius_18_white"
                app:layout_constraintBottom_toBottomOf="@id/iv_volunteer_info"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_volunteer_info_description"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="40dp"
                android:background="@drawable/bg_blue_talk_box"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iv_info_image_bottom">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="30dp"
                    android:paddingHorizontal="20dp"
                    android:text="@string/volunteer_info_description"
                    android:textAppearance="@style/TextAppearance.FindU.Body2_R_14"
                    android:textColor="@color/blue1"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_volunteer_info_application"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="40dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cl_volunteer_info_description">

                <TextView
                    android:id="@+id/tv_volunteer_info_application_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/volunteer_info_application_title"
                    android:textAppearance="@style/TextAppearance.FindU.Head1_SB_24"
                    android:textColor="@color/gray6"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_volunteer_info_application_description_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/volunteer_info_application_description_1"
                    android:textAppearance="@style/TextAppearance.FindU.Body2_R_14"
                    android:textColor="@color/gray6"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_volunteer_info_application_title" />

                <TextView
                    android:id="@+id/tv_volunteer_info_application_description_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="@string/volunteer_info_application_description_2"
                    android:textAppearance="@style/TextAppearance.FindU.Body2_R_14"
                    android:textColor="@color/gray6"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_volunteer_info_application_description_1" />

                <TextView
                    android:id="@+id/tv_volunteer_info_application_description_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="@string/volunteer_info_application_description_3"
                    android:textAppearance="@style/TextAppearance.FindU.Body2_R_14"
                    android:textColor="@color/gray6"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_volunteer_info_application_description_2" />

                <LinearLayout
                    android:id="@+id/ll_volunteer_info_application"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:background="@drawable/bg_radius_20_orange"
                    android:gravity="center"
                    android:paddingVertical="15dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_volunteer_info_application_description_3">

                    <ImageView
                        android:id="@+id/iv_volunteer_portal"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_info_navigate"
                        app:layout_constraintBottom_toBottomOf="@id/tv_volunteer_portal"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@id/tv_volunteer_portal" />

                    <TextView
                        android:id="@+id/tv_volunteer_portal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="@string/volunteer_info_application_portal"
                        android:textAppearance="@style/TextAppearance.FindU.Body1_SB_16"
                        android:textColor="@color/main_color"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/iv_volunteer_portal"
                        app:layout_constraintTop_toTopOf="parent" />
                </LinearLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:background="@drawable/bg_radius_10_gray"
                    android:paddingHorizontal="20dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ll_volunteer_info_application">

                    <TextView
                        android:id="@+id/tv_volunteer_alert_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/volunteer_info_alert_title"
                        android:textAppearance="@style/TextAppearance.FindU.Tag1_SB_12"
                        android:textColor="@color/red1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_volunteer_alert_description"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="10dp"
                        android:text="@string/volunteer_info_alert_description"
                        android:textAppearance="@style/TextAppearance.FindU.caption_11"
                        android:textColor="@color/gray5"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_volunteer_alert_title" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_volunteer_info_required_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="40dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cl_volunteer_info_application">

                <TextView
                    android:id="@+id/tv_volunteer_info_required_item_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/volunteer_info_required_item_title"
                    android:textAppearance="@style/TextAppearance.FindU.Head1_SB_24"
                    android:textColor="@color/gray6"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_volunteer_info_required_item_description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/volunteer_info_alert_required_item_description"
                    android:textAppearance="@style/TextAppearance.FindU.Body2_R_14"
                    android:textColor="@color/gray6"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_volunteer_info_required_item_title" />

                <TextView
                    android:id="@+id/tv_volunteer_info_required_item_description_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/volunteer_info_alert_required_item_detail_description_1"
                    android:textAppearance="@style/TextAppearance.FindU.Body2_R_14"
                    android:textColor="@color/gray6"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_volunteer_info_required_item_description" />

                <TextView
                    android:id="@+id/tv_volunteer_info_required_item_description_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/volunteer_info_alert_required_item_detail_description_2"
                    android:textAppearance="@style/TextAppearance.FindU.Body2_R_14"
                    android:textColor="@color/gray6"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_volunteer_info_required_item_description_1" />

                <TextView
                    android:id="@+id/tv_volunteer_info_required_item_description_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/volunteer_info_alert_required_item_detail_description_3"
                    android:textAppearance="@style/TextAppearance.FindU.Body2_R_14"
                    android:textColor="@color/gray6"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_volunteer_info_required_item_description_2" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/volunteer_info_alert_required_item_alert"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_volunteer_info_required_item_description_3" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_volunteer_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="40dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cl_volunteer_info_required_item">

                <TextView
                    android:id="@+id/tv_volunteer_info_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/volunteer_info_title"
                    android:textAppearance="@style/TextAppearance.FindU.Head1_SB_24"
                    android:textColor="@color/gray6"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_volunteer_info_first"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_volunteer_info_title">

                    <TextView
                        android:id="@+id/tv_volunteer_info_first_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/volunteer_info_first_title"
                        android:textAppearance="@style/TextAppearance.FindU.Body1_SB_16"
                        android:textColor="@color/gray6"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_volunteer_info_first_description"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/volunteer_info_first_description"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_volunteer_info_first_title" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="25dp"
                        android:background="@drawable/bg_radius_10_gray"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_volunteer_info_first_description">

                        <TextView
                            android:id="@+id/tv_first_alert"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/volunteer_info_first_alert_title"
                            android:textAppearance="@style/TextAppearance.FindU.Tag1_SB_12"
                            android:textColor="@color/red1"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tv_alert_description"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:layout_marginTop="5dp"
                            android:layout_marginBottom="10dp"
                            android:text="@string/volunteer_info_first_alert_description"
                            android:textAppearance="@style/TextAppearance.FindU.caption_11"
                            android:textColor="@color/gray5"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tv_first_alert" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_volunteer_info_second"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/cl_volunteer_info_first">

                    <TextView
                        android:id="@+id/tv_volunteer_second_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/volunteer_info_second_title"
                        android:textAppearance="@style/TextAppearance.FindU.Body1_SB_16"
                        android:textColor="@color/gray6"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_volunteer_second_description_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/volunteer_info_second_description_1"
                        android:textAppearance="@style/TextAppearance.FindU.Body2_R_14"
                        android:textColor="@color/gray6"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_volunteer_second_title" />

                    <TextView
                        android:id="@+id/tv_volunteer_second_description_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/volunteer_info_second_description_2"
                        android:textAppearance="@style/TextAppearance.FindU.Body2_R_14"
                        android:textColor="@color/gray6"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_volunteer_second_description_1" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_volunteer_info_third"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/cl_volunteer_info_second">

                    <TextView
                        android:id="@+id/tv_volunteer_third_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/volunteer_info_third_title"
                        android:textAppearance="@style/TextAppearance.FindU.Body1_SB_16"
                        android:textColor="@color/gray6"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_volunteer_third_description"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/volunteer_info_third_description"
                        android:textAppearance="@style/TextAppearance.FindU.Body2_R_14"
                        android:textColor="@color/gray6"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_volunteer_third_title" />

                    <TextView
                        android:id="@+id/tv_volunteer_third_description_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/volunteer_info_third_description_1"
                        android:textAppearance="@style/TextAppearance.FindU.Body2_R_14"
                        android:textColor="@color/gray6"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_volunteer_third_description" />

                    <TextView
                        android:id="@+id/tv_volunteer_third_description_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/volunteer_info_third_description_2"
                        android:textAppearance="@style/TextAppearance.FindU.Body2_R_14"
                        android:textColor="@color/gray6"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_volunteer_third_description_1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/volunteer_info_third_alert_title"
                        android:textAppearance="@style/TextAppearance.FindU.caption_12"
                        android:textColor="@color/gray5"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_volunteer_third_description_2" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_volunteer_info_fourth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/cl_volunteer_info_third">

                    <TextView
                        android:id="@+id/tv_volunteer_fourth_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/volunteer_info_fourth_title"
                        android:textAppearance="@style/TextAppearance.FindU.Body1_SB_16"
                        android:textColor="@color/gray6"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_volunteer_fourth_sub_title_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/volunteer_info_fourth_sub_title_1"
                        android:textAppearance="@style/TextAppearance.FindU.Body2_R_14"
                        android:textColor="@color/gray6"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_volunteer_fourth_title" />

                    <TextView
                        android:id="@+id/tv_volunteer_fourth_sub_description_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/volunteer_info_fourth_sub_description_1"
                        android:textAppearance="@style/TextAppearance.FindU.caption_12"
                        android:textColor="@color/gray5"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_volunteer_fourth_sub_title_1" />


                    <TextView
                        android:id="@+id/tv_volunteer_fourth_sub_title_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/volunteer_info_fourth_sub_title_2"
                        android:textAppearance="@style/TextAppearance.FindU.Body2_R_14"
                        android:textColor="@color/gray6"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_volunteer_fourth_sub_description_1" />

                    <TextView
                        android:id="@+id/tv_volunteer_fourth_sub_description_2"
                        android:layout_width="wrap_content"
