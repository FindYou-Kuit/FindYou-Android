<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.ui.search.tablayout.SearchReportFragment">

    <ImageView
        android:id="@+id/iv_search_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:src="@drawable/img_search_banner_witness"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/ib_search_filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:background="@null"
        android:src="@drawable/img_search_filters"
        app:layout_constraintStart_toStartOf="@id/iv_search_banner"
        app:layout_constraintTop_toBottomOf="@id/iv_search_banner" />

    <ImageButton
        android:id="@+id/ib_search_horizontal_sort"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="15dp"
        android:background="@null"
        android:src="@drawable/ic_search_horizontal_sort"
        app:layout_constraintEnd_toEndOf="@id/iv_search_banner"
        app:layout_constraintTop_toBottomOf="@id/iv_search_banner" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_search_horizontal_content"
        android:layout_width="320dp"
        android:layout_height="0dp"
        android:layout_marginTop="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:listitem="@layout/search_horizontal_content_item"
        app:layout_constraintTop_toBottomOf="@id/ib_search_filter" />

</androidx.constraintlayout.widget.ConstraintLayout>